# Copia como .env.production EN EL SERVIDOR (nunca lo subas a GitHub) y llena los valores.
# Genera claves con:  openssl rand -base64 32

# --- PostgreSQL ---
POSTGRES_USER=fersautos
POSTGRES_PASSWORD=CAMBIA_ESTO_clave_larga_aleatoria
POSTGRES_DB=fersautos
# "db" es el nombre del servicio en compose.prod.yml (red interna de Docker)
DATABASE_URL=postgres://fersautos:CAMBIA_ESTO_clave_larga_aleatoria@db:5432/fersautos

# --- Better Auth ---
BETTER_AUTH_SECRET=CAMBIA_ESTO_otra_clave_de_32_bytes
# URL pública EXACTA con https (también la usa el código QR de Panel -> Compartir)
BETTER_AUTH_URL=https://catalogo.TU-DOMINIO.com

# --- Archivos ---
# R2 aún no está implementado en el código: en el VPS se usa disco local (volumen "archivos")
ALMACENAMIENTO=local

# --- IA para leer PDF de precios ---
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
IA_MODELO=
IA_LECTURAS_MES=60
ANTHROPIC_API_KEY=

# --- Monitor del VPS (repositorio MetricasVPS) ---
# Red interna de Docker: "metricas-app" es el alias del monitor en la red "proxy"
METRICAS_INGESTA_URL=http://metricas-app:4000/ingesta/presencia
# El mismo valor que INGESTA_TOKEN del monitor
METRICAS_TOKEN=
