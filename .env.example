# Copia este archivo como .env y ajusta si lo necesitas.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- PostgreSQL (lo usa docker-compose.yml) ---
POSTGRES_USER=fersautos
POSTGRES_PASSWORD=fersautos_local
POSTGRES_DB=fersautos
# Cambia el puerto si ya tienes otro PostgreSQL instalado usando el 5432
POSTGRES_PORT=5432

# --- Conexión de la app (debe coincidir con lo de arriba) ---
DATABASE_URL=postgres://fersautos:fersautos_local@localhost:5432/fersautos

# --- Autenticación (Better Auth) ---
# Clave para firmar las cookies de sesión. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
BETTER_AUTH_URL=http://localhost:3000
