# Copia este archivo como .env y ajusta si lo necesitas.
# .env NUNCA se sube a GitHub (está en .gitignore).

# --- PostgreSQL (lo usa docker-compose.yml) ---
POSTGRES_USER=fersautos
POSTGRES_PASSWORD=fersautos_local
POSTGRES_DB=fersautos
# Cambia el puerto si ya tienes otro PostgreSQL instalado usando el 5432
POSTGRES_PORT=5432

# --- Conexión de la app (debe coincidir con lo de arriba) ---
DATABASE_URL=postgres://fersautos:fersautos_local@localhost:5432/fersautos

# --- Autenticación (Better Auth) ---
# Clave para firmar las cookies de sesión. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
BETTER_AUTH_URL=http://localhost:3000

# --- Archivos (fotos de cédula, firmas, PDF) ---
# local: se guardan en la carpeta almacenamiento/ del proyecto (desarrollo)
# r2:    Cloudflare R2 (producción, llega con el despliegue)
ALMACENAMIENTO=local

# --- Lectura de precios con IA (opcional) ---
# Por defecto usa Google Gemini, que tiene plan gratuito y no pide tarjeta.
# Crea la llave en https://aistudio.google.com/apikey
# Sin llave, la carga de PDF muestra un aviso y todo lo demás funciona igual.
IA_PROVEEDOR=gemini
GEMINI_API_KEY=
# Modelo (vacío = el predeterminado del proveedor) y tope de lecturas por mes
IA_MODELO=
IA_LECTURAS_MES=60

# Alternativa de pago: IA_PROVEEDOR=anthropic y la llave de console.anthropic.com
ANTHROPIC_API_KEY=

# --- Monitor del VPS (opcional) ---
# Para ver usuarios en vivo en el panel MetricasVPS corriendo en tu PC. Vacío = desactivado.
METRICAS_INGESTA_URL=
METRICAS_TOKEN=
